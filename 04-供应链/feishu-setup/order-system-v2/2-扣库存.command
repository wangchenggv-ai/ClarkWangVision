#!/bin/bash
# ════════════════════════════════════════════════════════════
#  高视高清 · 扣减库存（双击运行）
#  仓库拣货核对无误后双击本文件，扣减最近一批的库存并改为「已发货」
# ════════════════════════════════════════════════════════════

cd "$(dirname "$0")" || exit 1
PY=".venv/bin/python"; [ -x "$PY" ] || PY="python3"

clear
echo "════════════════════════════════════════════"
echo "        高视高清 · 扣减库存"
echo "════════════════════════════════════════════"
echo ""

if [ ! -s "output/last_batch.txt" ]; then
  echo "⚠️  还没有可扣减的批次。"
  echo "   请先用「1-处理订单」处理订单，再回来扣库存。"
  echo ""
  read -r -p "按回车键关闭… "
  exit 0
fi

echo "  最近批次：$(cat output/last_batch.txt)"
echo "  （请确认仓库已拣货并核对无误，扣减后库存不可自动恢复）"
echo ""
"$PY" deduct.py        # 无参 → 自动用最近批次；脚本内部还会再确认一次片数

echo ""
read -r -p "按回车键关闭… "
