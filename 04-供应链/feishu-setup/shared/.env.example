FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # 飞书多维表格 App Token（必填）
ADMIN_TOKEN=your_admin_password                     # 管理页访问密码
SERVER_BASE_URL=https://your-domain.com             # 服务器外网地址（QR验真链接用）
ALLOWED_ORIGINS=https://your-domain.com             # 允许跨域的来源（逗号分隔多个，留空则不限制）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/...       # 飞书群机器人 Webhook（可选）
NOTIFY_APP_ID=cli_xxxxxxxx                          # 飞书通知应用 App ID（可选）
NOTIFY_APP_SECRET=xxxxxxxx                          # 飞书通知应用 Secret（可选）
NOTIFY_CHAT_ID=oc_xxxxxxxx                          # 飞书群 Chat ID（可选）
MIMO_API_URL=https://api.xxx.com                    # MiMo 大模型 API 地址（可选）
MIMO_API_KEY=xxxxxxxx                               # MiMo API Key（可选）
